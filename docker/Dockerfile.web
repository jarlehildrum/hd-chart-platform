# For now, use the same build as API but configured for web
# Later we can separate into dedicated web app
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src

# Copy project files for restore
COPY src/HdPlatform.Core/*.csproj ./HdPlatform.Core/
COPY src/HdPlatform/*.csproj ./HdPlatform/
RUN dotnet restore ./HdPlatform/HdPlatform.csproj

# Copy source and build
COPY src/ ./
WORKDIR /src/HdPlatform
RUN dotnet build HdPlatform.csproj -c Release -o /app/build
RUN dotnet publish HdPlatform.csproj -c Release -o /app/publish --no-restore

# Runtime stage
FROM mcr.microsoft.com/dotnet/aspnet:10.0 AS runtime
WORKDIR /app

# Install required packages
RUN apt-get update && apt-get install -y \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Copy published app
COPY --from=build /app/publish .

# Copy web assets
COPY src/HdPlatform/wwwroot/ ./wwwroot/

# Environment variables for web mode
ENV ASPNETCORE_ENVIRONMENT=Production
ENV ASPNETCORE_URLS=http://+:5001
ENV HD_MODE=Web

EXPOSE 5001

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=5s --retries=3 \
    CMD curl --fail http://localhost:5001/health || exit 1

ENTRYPOINT ["dotnet", "HdPlatform.dll"]